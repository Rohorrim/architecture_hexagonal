<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.wgt.imt</groupId>
    <artifactId>architecture</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>architecture</name>
    <description>POM parent de l'architecture</description>

    <modules>
        <module>adapters-in-listeners</module>
        <module>adapters-in-mcp</module>
        <module>adapters-in-rest</module>
        <module>adapters-out-bdd</module>
        <module>adapters-out-writers</module>
        <module>application</module>
        <module>domain</module>
    </modules>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Dépendances internes -->
            <dependency>
                <groupId>com.wgt.imt</groupId>
                <artifactId>architecture-adapters-in-listeners</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wgt.imt</groupId>
                <artifactId>architecture-adapters-in-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wgt.imt</groupId>
                <artifactId>architecture-adapters-in-mcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wgt.imt</groupId>
                <artifactId>architecture-adapters-out-bdd</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wgt.imt</groupId>
                <artifactId>architecture-adapters-out-writers</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wgt.imt</groupId>
                <artifactId>architecture-domain</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Dépendances externes -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <type>pom</type>
                <version>3.5.6</version>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations</artifactId>
                <version>2.2.27</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>dsp-artifacts</id>
            <url>https://dsp-artifacts.fr.world.socgen/artifactory/maven-virtual-9e752c1a-fc2b-40e1-a73d-6fe92757981b
            </url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>dsp-artifacts</id>
            <url>https://dsp-artifacts.fr.world.socgen/artifactory/maven-virtual-9e752c1a-fc2b-40e1-a73d-6fe92757981b
            </url>
        </pluginRepository>
    </pluginRepositories>
</project>
